# Track only the GitHub project files; everything else in this directory
# (Perforce workspace files, .p4config.txt, etc.) is ignored.
/*
!/3.7/
!/devtools/
!/doc/
!/.gitignore
!/LICENSE.txt
!/README.md
!/build.bat
!/build.sh

# Compiled class file
*.class

# Log file
*.log

# Eclipse IDE
.metadata
bin/
tmp/
target/

# VS Code
.vscode/

# macOS
.DS_Store


# Perforce-only files that must not be published
/3.7/build/p4eclipse_parent/build.xml
/3.7/build/p4eclipse_parent/m2_settings_templ.xml
CLAUDE.md
